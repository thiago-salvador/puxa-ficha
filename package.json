{
  "name": "puxa-ficha",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma cívica de consulta pública sobre candidatos das eleições brasileiras: ficha, comparador e pontos de atenção com fontes visíveis.",
  "license": "Apache-2.0",
  "homepage": "https://puxaficha.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiago-salvador/puxa-ficha.git"
  },
  "bugs": {
    "url": "https://github.com/thiago-salvador/puxa-ficha/issues"
  },
  "author": "Thiago Salvador",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "dev:raw": "next dev --turbopack",
    "build": "next build --turbopack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:spell": "cspell lint --no-progress \"src/app/(site)/privacidade/page.tsx\" \"src/app/(site)/sobre/page.tsx\" src/app/not-found.tsx \"src/app/(site)/page.tsx\" src/app/layout.tsx",
    "lint:spell:ui": "cspell lint --no-progress \"src/app/**/*.tsx\" \"src/components/**/*.tsx\" --exclude \"**/internaltest/**\" --exclude \"**/styleguide/**\" --exclude \"**/preview/**\"",
    "test": "node --import tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "test:pesquisas:dados": "node --conditions react-server --import tsx --test tests/pesquisas-eleitorais-dados.test.ts",
    "test:programas-governo:schema": "node --conditions react-server --import tsx --test tests/programa-governo-schema.test.ts",
    "test:programas-governo:extracao": "node --conditions react-server --import tsx --test tests/programa-governo-extracao.test.ts",
    "test:pesquisas:identidade": "node --conditions react-server --import tsx --test tests/pesquisas-eleitorais-identidade.test.ts",
    "test:pesquisas:selecao": "node --conditions react-server --import tsx --test tests/pesquisas-eleitorais-selecao.test.ts",
    "test:pesquisas:ui": "node --import tsx --test tests/pesquisas-eleitorais-ui.test.tsx",
    "test:pesquisas": "npm run test:pesquisas:dados && npm run test:pesquisas:identidade && npm run test:pesquisas:selecao && node --conditions react-server --import tsx --test tests/pesquisas-governadores-cobertura.test.ts && npm run test:pesquisas:ui && node --import tsx --test tests/pesquisas-eleitorais-audit.test.ts tests/pesquisas-eleitorais-golden.test.ts tests/candidato-profile-tabs.test.ts",
    "test:visual:pesquisas": "npm run build && playwright test -c tests/visual/pesquisas-eleitorais.playwright.config.ts",
    "test:pesquisas:production-smoke": "playwright test -c tests/visual/pesquisas-production-smoke.playwright.config.ts && node -e \"console.log('production smoke passed')\"",
    "test:pesquisas:monitoramento": "node --conditions react-server --import tsx --test tests/pesquisas-monitoramento-golden.test.ts tests/pesquisas-monitoramento-tse.test.ts",
    "test:pesquisas:monitoramento:isolamento": "node --conditions react-server --import tsx --test tests/pesquisas-monitoramento-isolamento.test.ts",
    "test:pesquisas:monitoramento:rede": "node --conditions react-server --import tsx --test tests/pesquisas-monitoramento-rede.test.ts",
    "test:pesquisas:monitoramento:workflow": "node --conditions react-server --import tsx --test tests/pesquisas-monitoramento-workflow.test.ts",
    "audit:pesquisas:monitoramento": "node --conditions react-server --import tsx scripts/audit/audit-pesquisas-monitoramento.ts",
    "audit:pesquisas:monitoramento:scope": "node scripts/audit/verify-pesquisas-monitoramento-scope.mjs",
    "monitor:pesquisas": "node --conditions react-server --import tsx scripts/pesquisas-monitoramento.ts",
    "monitor:pesquisas:manual": "node --conditions react-server --import tsx scripts/pesquisas-monitoramento.ts --live-check",
    "test:visual:debates": "playwright test -c tests/visual/debates-imprensa.playwright.config.ts",
    "audit:pesquisas:gate": "node --conditions react-server --import tsx scripts/audit/audit-pesquisas-eleitorais.ts",
    "verify:pesquisas": "npm run audit:pesquisas:gate && npm run test:pesquisas && npm run test:visual:pesquisas && npm run lint && npm run lint:spell:ui && npm run typecheck && npm run check:scripts && git diff --check",
    "test:alerts:nightly": "node --import tsx --test tests/alerts-nightly-e2e.test.ts",
    "test:coverage:raw": "node scripts/run-c8-node26.mjs --config c8.config.json node --import tsx --test --test-force-exit --test-concurrency=1 tests/**/*.test.ts tests/**/*.test.tsx",
    "check:dead-code": "knip --config knip.json --include files,dependencies,unlisted,unresolved,exports --no-progress --max-issues 0",
    "test:a11y": "playwright test tests/visual/a11y.spec.ts",
    "test:visual": "playwright test",
    "test:playwright:launch": "playwright test -c playwright.launch.config.ts",
    "test:search-smoke": "PF_BASE_URL=https://puxaficha.com.br playwright test tests/visual/search-smoke.spec.ts --project=desktop",
    "test:visual:editorial": "playwright test tests/visual/editorial-badges.spec.ts",
    "test:visual:editorial:local": "PF_PLAYWRIGHT_EDITORIAL_WEBSERVER=1 PF_BASE_URL=http://127.0.0.1:3000 playwright test -c playwright.editorial.config.ts --project=desktop",
    "test:visual:mobile": "playwright test --project=mobile",
    "test:visual:quiz": "playwright test tests/visual/quiz.spec.ts",
    "test:visual:quiz:mobile": "playwright test --project=mobile tests/visual/quiz.spec.ts",
    "test:visual:quiz-og": "npm run build && playwright test -c playwright.quiz-og.config.ts",
    "check:env-contract": "node --test tests/env-contract-workflow-scanner.test.mjs && node scripts/check-env-contract.mjs",
    "check:scripts": "tsc --project tsconfig.scripts.json",
    "cache:aquecer": "tsx scripts/aquecer-cache-publico.ts",
    "audit:public-document-exposure:gate": "tsx scripts/audit-public-document-exposure.ts",
    "audit:public-security-surface:gate": "tsx scripts/audit-public-security-surface.ts",
    "audit:route-guards": "tsx scripts/audit-route-guards.ts",
    "audit:supabase-abort-signal": "tsx scripts/audit-supabase-abort-signal.ts",
    "audit:superficie": "tsx scripts/audit/audit-superficie.ts",
    "audit:validade-temporal": "tsx scripts/audit/audit-validade-temporal.ts",
    "data:fotos-oficiais": "tsx scripts/ingest-fotos-oficiais.ts",
    "data:programas-governo": "tsx scripts/programas-governo-presidencia.ts",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "audit:fotos": "tsx scripts/check-candidate-photo-resolution.ts",
    "audit:fotos:gate": "tsx scripts/check-candidate-photo-resolution.ts --gate",
    "audit:candidate-assets:gate": "tsx scripts/audit-candidate-assets.ts --verify-removals --baseline \"$PF_CANDIDATE_ASSET_BASELINE_SHA\" --runtime-references data/candidate-runtime-asset-references.json",
    "audit:marcadores-tse": "tsx scripts/audit-marcadores-tse-publicos.ts",
    "audit:marcadores-tse:gate": "tsx scripts/audit-marcadores-tse-publicos.ts --gate",
    "audit:encoding-publico": "tsx scripts/audit-encoding-publico.ts",
    "audit:encoding-publico:gate": "tsx scripts/audit-encoding-publico.ts --gate",
    "audit:encoding-publico:provar": "bash scripts/audit/provar-public-text-encoding.sh",
    "audit:seed-sq-identity": "tsx scripts/audit-seed-sq-identity.ts",
    "audit:seed-sq-identity:gate": "tsx scripts/audit-seed-sq-identity.ts --gate",
    "audit:candidaturas:gate": "tsx scripts/audit/check-candidatura-resultados.ts",
    "data:identidade-etapa2:fontes": "tsx scripts/audit/fetch-tse-fontes-2026.ts",
    "data:identidade-etapa2:gerar": "tsx scripts/audit/gerar-identidade-etapa2.ts",
    "audit:ids-cohort": "tsx scripts/check-ids-cohort.ts",
    "audit:ids-cohort:gate": "tsx scripts/check-ids-cohort.ts --fail-on-mismatch",
    "apply:factual-fixes:dry-run": "tsx scripts/apply-current-factual-fixes.ts --dry-run",
    "persist:sq": "tsx scripts/persist-sq-candidato.ts",
    "data:recalc-financiamento-doadores": "tsx scripts/recalc-financiamento-maiores-doadores.ts --apply",
    "data:recalc-financiamento-doadores:dry-run": "tsx scripts/recalc-financiamento-maiores-doadores.ts --dry-run",
    "data:retencao-operacional": "tsx scripts/retencao-operacional.ts --apply",
    "data:retencao-operacional:dry-run": "tsx scripts/retencao-operacional.ts --dry-run",
    "data:link-check-fontes:dry-run": "tsx scripts/link-check-pontos-atencao.ts --dry-run",
    "data:link-check-fontes:gate": "tsx scripts/link-check-pontos-atencao.ts --dry-run --fail-on-dead --fail-on-sem-substancia --gate-somente-publicos",
    "data:link-check-fontes:gate:tudo": "tsx scripts/link-check-pontos-atencao.ts --dry-run --fail-on-dead --fail-on-sem-substancia",
    "data:link-check-fontes:revalidar": "tsx scripts/link-check-pontos-atencao.ts --dry-run --fail-on-dead --fail-on-sem-substancia --fail-on-morte-suspeita --gate-somente-publicos",
    "data:link-check-fontes": "tsx scripts/link-check-pontos-atencao.ts --apply",
    "data:curadoria:registrar": "tsx scripts/registrar-revisao-curadoria.ts",
    "data:curadoria:processos:lote": "tsx scripts/curadoria-processos-lote.ts",
    "audit:cobertura": "tsx scripts/audit/coverage-report.ts",
    "audit:cobertura:check": "tsx scripts/audit/check-report.ts",
    "audit:partidos-oficiais": "PF_DRY_RUN=1 tsx scripts/audit/partidos-oficiais.ts",
    "audit:financiamento:readback": "tsx scripts/audit/readback-financiamento-universo.ts",
    "audit:financiamento:prove": "bash scripts/audit/provar-financiamento-universo.sh",
    "audit:financiamento:manifest": "tsx scripts/audit/gerar-manifesto-financiamento-universo.ts --output=/tmp/pf-financiamento-manifesto.json && cmp /tmp/pf-financiamento-manifesto.json QA/evidencias/2026-08-10-financiamento-universo/manifesto-235.json",
    "audit:financiamento:fontes": "tsx scripts/audit/verificar-pacotes-financiamento.ts && tsx scripts/audit/gerar-manifesto-financiamento-universo.ts --output=/tmp/pf-financiamento-manifesto-fontes.json && cmp /tmp/pf-financiamento-manifesto-fontes.json QA/evidencias/2026-08-10-financiamento-universo/manifesto-235.json",
    "eval:completude": "node scripts/eval-profile-completeness.mjs",
    "eval:completude:self-test": "node scripts/eval-profile-completeness.mjs --self-test",
    "settings:check": "node --import tsx --test tests/settings-contract.test.ts",
    "audit:cobertura:allowlist": "tsx scripts/audit/check-migrations-allowlist.ts",
    "audit:ledger:gate": "tsx scripts/audit/check-ledger-vs-repo.ts",
    "audit:escrita-auditada:gate": "tsx scripts/audit/check-escrita-auditada.ts",
    "audit:link-check-snapshot": "tsx scripts/audit/link-check-from-snapshot.ts",
    "audit:processos:revisao": "tsx scripts/gerar-revisao-processos-curadoria.ts",
    "audit:processos:revisao-final:montar": "tsx scripts/montar-revisao-final-processos.ts",
    "audit:processos:revisao-final": "tsx scripts/validar-revisao-final-processos.ts",
    "audit:cobertura:servir": "python3 scripts/audit/review-server.py 8799 ~/.disposable-html ~/.disposable-html/decisoes-revisao.jsonl",
    "audit:migrations:classificar": "tsx scripts/audit/classificar-migrations.ts",
    "audit:migrations:replay": "bash scripts/audit/replay-migrations.sh",
    "audit:rollback:provar": "bash scripts/audit/provar-rollback.sh",
    "audit:b2:provar": "bash scripts/audit/provar-migration-b2.sh",
    "audit:despublicacao:provar": "bash scripts/audit/provar-despublicacao-votacoes.sh",
    "audit:daciolo:provar": "bash scripts/audit/provar-migration-daciolo.sh",
    "audit:patrimonio-rerun:readback": "tsx scripts/audit/readback-patrimonio-rerun.ts",
    "audit:release:readback": "bash scripts/audit/readback-release-pf-ajustes.sh",
    "audit:fase4:readback": "bash scripts/audit/readback-publico-fase4.sh",
    "audit:processos:curadoria-69:provar": "bash scripts/audit/provar-migration-processos-curadoria-69.sh",
    "audit:processos:curadoria-66:provar": "bash scripts/audit/provar-migration-processos-curadoria-66.sh",
    "audit:destaques:tse-8:provar": "bash scripts/audit/provar-migration-destaques-trajetoria-tse-8.sh",
    "audit:votacoes:senado:provar": "bash scripts/audit/provar-votacoes-senado-exatas.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cspell/dict-pt-br": "^2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-react-devtools": "^0.4.0",
    "c8": "^12.0.0",
    "cspell": "^10.0.1",
    "csv-parse": "^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fallow": "^3.17.0",
    "knip": "^6.32.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-devtools-core": "^7.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "brace-expansion@5": "^5.0.9",
    "brace-expansion@1": "^1.1.18",
    "fast-uri@3": "^3.1.5",
    "nanoid@3": "^3.3.17",
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
