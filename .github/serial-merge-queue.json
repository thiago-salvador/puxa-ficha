{
  "version": 1,
  "enabled": true,
  "repository": "thiago-salvador/puxa-ficha",
  "defaultBranch": "main",
  "concurrency": {
    "group": "serial-merge-queue",
    "cancelInProgress": false
  },
  "labels": {
    "active": "merge-queue/active",
    "preMerge": "merge-queue/pre-merge",
    "postMerge": "merge-queue/post-merge",
    "rollback": "merge-queue/rollback",
    "blocked": "merge-queue/blocked",
    "rollbackPr": "merge-queue/rollback-pr"
  },
  "queue": {
    "orderBy": [
      "createdAt",
      "number"
    ],
    "requireUpToDate": true,
    "baseBranch": "main",
    "excludeDrafts": true,
    "excludeLabels": [
      "merge-queue/rollback-pr"
    ],
    "trustedContextActors": [
      "thiago-salvador"
    ],
    "trustedContextApps": []
  },
  "checks": {
    "acceptedConclusions": [
      "success"
    ],
    "preMerge": {
      "required": [
        "verify",
        "Rotas e acessibilidade (build local)",
        "Cobertura (bloqueante)",
        "CodeQL",
        "Analyze (python)",
        "Analyze (javascript-typescript)",
        "Vercel"
      ],
      "conditionalRequired": [
        "Gate de replay (conjunto de falhas congelado)"
      ],
      "observedOptional": [
        "CodeRabbit"
      ],
      "includeAllPresent": true
    },
    "postMerge": {
      "required": [
        "verify",
        "Rotas e acessibilidade (build local)",
        "Cobertura (bloqueante)",
        "Ledger do banco vs supabase/migrations",
        "CodeQL analysis (javascript-typescript)",
        "CodeQL analysis (python)",
        "Analyze (python)",
        "Analyze (javascript-typescript)",
        "Vercel"
      ],
      "conditionalRequired": [
        "Gate de replay (conjunto de falhas congelado)"
      ],
      "includeAllPresent": true
    },
    "rollback": {
      "required": [
        "verify",
        "Rotas e acessibilidade (build local)",
        "Cobertura (bloqueante)",
        "Ledger do banco vs supabase/migrations",
        "CodeQL analysis (javascript-typescript)",
        "CodeQL analysis (python)",
        "Analyze (python)",
        "Analyze (javascript-typescript)",
        "Vercel"
      ],
      "conditionalRequired": [
        "Gate de replay (conjunto de falhas congelado)"
      ],
      "includeAllPresent": true
    }
  },
  "production": {
    "provider": "vercel",
    "projectName": "puxa-ficha",
    "environment": "Production",
    "url": "https://puxaficha.com.br",
    "stagedDeployment": {
      "required": true,
      "target": "production",
      "requiredState": "READY",
      "requireMergeSha": true,
      "hold": {
        "provider": "vercel-auto-assignment-disabled",
        "required": true,
        "githubStatusContext": "Vercel - puxa-ficha: staged-release"
      }
    },
    "stagedChecks": {
      "required": true,
      "checks": [
        "Vercel - puxa-ficha: staged-release"
      ]
    },
    "promotion": {
      "required": true,
      "mode": "explicit-vercel-promote",
      "recoveryMode": "explicit-vercel-promote"
    },
    "publicReadback": {
      "required": true,
      "checks": [
        "Production release closure"
      ],
      "url": "https://puxaficha.com.br/api/deployment-info",
      "expected": {
        "httpStatus": 200,
        "ok": true,
        "environment": "production",
        "commitRef": "main",
        "commitSha": "$MERGE_COMMIT_SHA"
      }
    },
    "rollback": {
      "mode": "vercel-instant-rollback",
      "checks": [
        "Production rollback recovery"
      ],
      "requirePreviousReadyDeployment": true,
      "verifyPreviousSha": true,
      "promoteRecoveryDeployment": true
    }
  },
  "releaseGate": {
    "name": "Serial release orchestration",
    "required": false,
    "initialState": "pending",
    "successState": "success",
    "failClosedOnMissingHold": true
  },
  "ledger": {
    "predecessorEnv": "PF_LEDGER_PREDECESSOR",
    "manifestEnv": "PF_LEDGER_MANIFEST",
    "manifestPath": ".github/merge-queue/irreversible-change-manifest.json",
    "manifestFormat": "json-releases-or-json-or-lines",
    "requirePredecessor": true
  },
  "irreversibleChanges": {
    "migrationPathPatterns": [
      "supabase/migrations/**",
      "supabase/migrations-pendentes/**"
    ],
    "databaseRollbackMode": "migration-specific",
    "pathPatterns": [
      "supabase/migrations/**",
      "supabase/migrations-pendentes/**",
      "supabase/rollback/**",
      ".github/workflows/**",
      ".github/serial-merge-queue.json",
      "scripts/merge-queue/**",
      "vercel.json",
      "src/app/api/**/route.*",
      "scripts/ingest*",
      "scripts/revalidate*",
      "scripts/**/*email*"
    ],
    "sensitiveTokens": [
      "SUPABASE_DB_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "RESEND_API_KEY",
      "CRON_SECRET"
    ],
    "manifestPath": ".github/merge-queue/irreversible-change-manifest.json",
    "requireValidatedManifest": true,
    "requireNamedRemoteWriteApproval": true,
    "executePullRequestSql": false
  },
  "notifications": {
    "provider": "github-issue",
    "assignee": "thiago-salvador",
    "deduplicateBy": "failure-signature",
    "watchdogMarker": "serial-merge-queue-watchdog"
  },
  "secrets": {
    "required": [
      "MERGE_QUEUE_GH_TOKEN",
      "VERCEL_TOKEN",
      "VERCEL_ORG_ID",
      "VERCEL_PROJECT_ID",
      "VERCEL_AUTOMATION_BYPASS_SECRET"
    ],
    "optional": [],
    "missingPolicy": "block"
  }
}
