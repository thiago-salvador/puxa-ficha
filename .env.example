# Puxa Ficha environment template
#
# Copy only the variables needed for the command you will run to `.env.local`.
# Keep real credentials out of Git. Blank values below are intentional.

# Public and server-side Supabase reads
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privileged Supabase and database operations. Leave blank for normal local UI work.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
PF_DATABASE_URL=

# Public site metadata and local browser targets
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_X_HANDLE=@puxaficha
PF_BASE_URL=http://127.0.0.1:3000
PF_PESQUISAS_EMPTY_SLUG=
PF_PUBLIC_SITE_URL=https://puxaficha.com.br
PF_PUBLIC_ORIGIN=https://puxaficha.com.br

# Alerts, email, protected routes and cache revalidation
NEXT_PUBLIC_ALERTS_EMAIL_ENABLED=false
RESEND_API_KEY=
PF_ALERTS_FROM_EMAIL=
# Single plain email address. Do not use a display name or multiple addresses.
PF_ALERTS_REPLY_TO_EMAIL=
SMTP_FROM=
CRON_SECRET=
# Opt-in explícito para o cron apagar short-links expirados e notification_log antigo.
PF_OPERATIONAL_RETENTION_ENABLED=
PF_REVALIDATE_SECRET=
PF_INTERNAL_TOKEN=
PF_PREVIEW_TOKEN=
PF_ALERTS_TOKEN_SALT=
PF_ALERTS_IP_SALT=
PF_ALERTS_TOKEN_ENCRYPTION_KEY=
PF_QUIZ_SHORT_LINK_SALT=
PF_QUIZ_SHORT_LINKS_FILE=
PF_CRON_CHAIN_ORIGIN=
PF_RUNTIME_SMOKE_ORIGIN=
PF_LEDGER_PREDECESSOR=
PF_LEDGER_MANIFEST=

# Sentry. Preview reporting is opt-in; sample-rate defaults are documented.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENABLE_PREVIEW=0
NEXT_PUBLIC_SENTRY_ENABLE_PREVIEW=0
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Runtime tuning and explicit safety switches
PF_CURATION_PHASE=
PF_SUPABASE_FETCH_CONCURRENCY=24
PF_SUPABASE_FETCH_QUEUE_TIMEOUT_MS=10000
SUPABASE_ATTEMPT_TIMEOUT_MS=15000
PF_FORCE_PRODUCTION_SECURITY_HEADERS=0
PF_RELEASE_VERIFY_CACHE_BYPASS=

# Ingestion and audit scripts
TRANSPARENCIA_API_KEY=
PF_TRANSPARENCIA_API_BASE=
INSTAGRAM_APP_ID=
PF_DOADOR_CPF_HASH_SALT=
PF_DRY_RUN=1
PF_INGEST_SLUGS=
PF_CAMARA_CANDIDATE_TIMEOUT_MS=
PF_SENADO_CANDIDATE_TIMEOUT_MS=
PF_TSE_FINANCIAMENTO_SLUGS=
PF_TSE_PATRIMONIO_SLUGS=
PF_TSE_ANOS=
PF_TSE_INGEST_DRY_RUN=1
PF_TSE_INGEST_SKIP_PATRIMONIO=0
PF_KEEP_TSE_DOWNLOADS=0
PF_MANUAL_REVIEW_PERIODO_FIM_CSV_PATH=
PF_AUDIT_RAIZ=
PF_AUDIT_REPORT_MAX_AGE_MS=
PF_EXPECTED_DEPLOY_SHA=
PF_EXPECTED_SHA=
PF_URL_PARA_VALIDAR=
PF_OUTPUT_DIR=
# Required only by the closed issue 138 production workflows; use a protected temporary path.
PF_BACKUP_PATH=
# Optional diagnostic override. Blank preserves the digest pinned by replay scripts.
PF_REPLAY_POSTGRES_IMAGE=

# Focused local QA controls
PF_PLAYWRIGHT_EDITORIAL_WEBSERVER=0
PF_QUIZ_OG_BASE_URL=http://127.0.0.1:3000
PF_RUN_SEARCH_SMOKE=0

# Governadores 2026 batch model runners. Defaults use the CLIs available in PATH.
PF_QWEN_CLI=
PF_QWEN_EXTRA_ARGS=
PF_QWEN_TIMEOUT_MS=
PF_CODEX_CLI=
PF_CODEX_EXTRA_ARGS=
PF_CODEX_MODEL=
PF_CODEX_REASONING_EFFORT=
PF_CODEX_TIMEOUT_MS=
PF_JUDGE_MODEL=
PF_CLAUDE_CLI=
PF_CLAUDE_JUDGE_MODEL=
PF_CLAUDE_MAX_BUDGET_USD=
PF_CLAUDE_TIMEOUT_MS=
PF_OPENCODE_GO=
PF_OPENCODE_TIMEOUT_MS=
PF_OPENCODE_TIMEOUT_PADDING_MS=
PF_OPENCODE_GRACE_MS=

# Internal batch context. The driver sets these for child processes; do not set manually.
PF_EXECUTION_ID=
PF_CANDIDATO_CHAVE=
PF_CANDIDATO_SQ=
PF_CANDIDATO_UF=
PF_CANDIDATO_REGIAO=
PF_MODEL_TELEMETRY_PATH=
